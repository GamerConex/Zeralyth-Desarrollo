<%- include('partials/header') %><h1>Nuevo recurso</h1><form method="post" action="/recursos"><input name="title" placeholder="Título" required><input name="shortDescription" placeholder="Descripción breve" required><textarea name="longDescription" placeholder="Descripción larga" required></textarea><input name="logo" placeholder="URL logo"><input name="fileUrl" placeholder="URL archivo" required><input name="fileName" placeholder="Nombre archivo" required><input name="fileSize" type="number" placeholder="Tamaño bytes" required><select name="category"><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><input name="links[discord]" placeholder="Discord"><input name="links[download]" placeholder="Descarga"><input name="links[source]" placeholder="Source"><button>Publicar</button></form><%- include('partials/footer') %>
