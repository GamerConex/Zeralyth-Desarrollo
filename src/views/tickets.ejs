<%- include('partials/header') %><h1>Tickets</h1><form method="post" action="/tickets"><input name="title" placeholder="Título" required><textarea name="description" placeholder="Describe tu problema" required></textarea><select name="priority"><option>low</option><option selected>normal</option><option>medium</option><option>high</option></select><button>Crear ticket</button></form><ul><% tickets.forEach(t=>{ %><li><strong><%= t.title %></strong> - <%= t.status %></li><% }) %></ul><%- include('partials/footer') %>
