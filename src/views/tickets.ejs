<%- include('partials/header') %>
<div class="section-head"><h1>🎫 Tickets</h1></div>
<form method="post" action="/tickets" class="pretty-form">
  <label for="title">🧾 Título del ticket</label>
  <input id="title" name="title" placeholder="Ej: No puedo descargar un recurso" required>

  <label for="description">✍️ Describe tu problema</label>
  <textarea id="description" name="description" placeholder="Cuéntanos el problema con detalles" required></textarea>

  <label for="priority">🚦 Prioridad</label>
  <select id="priority" name="priority"><option>low</option><option selected>normal</option><option>medium</option><option>high</option></select>
  <button class="btn btn-primary">📨 Crear ticket</button>
</form>
<ul class="list-clean"><% tickets.forEach(t=>{ %><li><strong>🎟️ <%= t.title %></strong> - <%= t.status %></li><% }) %></ul>
<%- include('partials/footer') %>
