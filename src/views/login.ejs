<%- include('partials/header') %>
<div class="section-head"><h1>🔑 Login</h1></div>
<form method="post" action="/login" class="pretty-form">
  <label for="identifier">👤 Usuario o email</label>
  <input id="identifier" name="identifier" placeholder="usuario o email" required>

  <label for="password">🔒 Contraseña</label>
  <input id="password" name="password" type="password" placeholder="contraseña" required>

  <button class="btn btn-primary">🚀 Entrar</button>
</form>
<% if (typeof discordEnabled !== 'undefined' && discordEnabled) { %>
  <a href="/auth/discord" class="btn btn-outline" style="margin-top:10px">💬 Entrar con Discord</a>
<% } %>
<%- include('partials/footer') %>
