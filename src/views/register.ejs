<%- include('partials/header') %>
<div class="section-head"><h1>📝 Registro</h1></div>
<form method="post" action="/registro" class="pretty-form">
  <label for="username">👤 Nombre de usuario</label>
  <input id="username" name="username" placeholder="Ej: VoxNovaYT" required>

  <label for="email">📧 Correo electrónico</label>
  <input id="email" type="email" name="email" placeholder="Ej: tucorreo@gmail.com" required>

  <label for="password">🔒 Contraseña</label>
  <input id="password" type="password" name="password" placeholder="Mínimo 8 caracteres" required>

  <button class="btn btn-primary">✅ Crear cuenta</button>
</form>
<%- include('partials/footer') %>
